# Template only. Copy to .env in your PRIVATE working directory.
# Match the UID/GID that owns your media folders. Run: id -u; id -g
PUID=1000
PGID=1000
TZ=Etc/UTC

# Optional provider-side port forwarding; requires a compatible VPN endpoint.
VPN_PORT_FORWARDING=off
VPN_PORT_FORWARDING_PROVIDER=protonvpn

# Never add VPN private keys, API keys, passwords or live addresses to this file in Git.
